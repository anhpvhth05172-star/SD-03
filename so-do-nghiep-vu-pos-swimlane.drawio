        <!-- In hóa đơn & Vận chuyển -> Khách nhận hàng (Nét đứt ngược lên khách hàng) -->
        <mxCell id="e_cross_nhan_hang" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#16a34a;strokeWidth=1.5;" edge="1" parent="pool_main" source="ht_van_chuyen" target="kh_nhan_hang">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Khách nhận hàng -> Decision nhận hàng -->
        <mxCell id="e_kh3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1e293b;strokeWidth=1.5;" edge="1" parent="lane_khach_hang" source="kh_nhan_hang" target="kh_dec_nhan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision nhận hàng -> Có -> Hoàn thành -->
        <mxCell id="e_kh4" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16a34a;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#15803d;fontSize=10;" edge="1" parent="lane_khach_hang" source="kh_dec_nhan" target="kh_hoan_thanh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Decision nhận hàng -> Không -> Đổi trả hoàn tiền -->
        <mxCell id="e_kh5" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#dc2626;strokeWidth=1.5;labelBackgroundColor=#ffffff;fontColor=#b91c1c;fontSize=10;" edge="1" parent="lane_khach_hang" source="kh_dec_nhan" target="kh_tra_hang">
          <mxGeometry relative="1" as="geometry" />
