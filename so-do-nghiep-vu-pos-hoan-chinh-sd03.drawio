        <mxCell id="ht_dec_ton" value="Còn hàng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontStyle=1;fontColor=#854d0e;" vertex="1" parent="lane_he_thong">
