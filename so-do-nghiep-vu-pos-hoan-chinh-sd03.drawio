        <mxCell id="tn_dong_ca" value="Cuối ca: Đóng ca &amp; Đối soát:&#xa;Đếm tiền mặt thực tế trong két,&#xa;so khớp hệ thống, in biên lai đối soát" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#ef4444;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#991b1b;" vertex="1" parent="lane_thu_ngan">
