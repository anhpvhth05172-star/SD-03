        <mxCell id="ht_dot_giam_gia" value="Áp dụng Đợt giảm giá (%):&#xa;Tính gia_sau_giam cho từng SKU&#xa;dựa trên đợt khuyến mãi đang mở" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#0f172a;" vertex="1" parent="lane_he_thong">
