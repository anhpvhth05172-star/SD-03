        <mxCell id="ht_check_ton" value="Kiểm tra tồn kho khả dụng:&#xa;SELECT so_luong_ton&#xa;FROM san_pham_chi_tiet WHERE id = ?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#0f172a;" vertex="1" parent="lane_he_thong">
