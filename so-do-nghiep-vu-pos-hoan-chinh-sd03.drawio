        <mxCell id="e_ca_no" value="Chưa mở" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#b91c1c;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="lane_thu_ngan" source="tn_check_ca" target="tn_mo_ca">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mo_ca_done" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=1.5;" edge="1" parent="lane_thu_ngan" source="tn_mo_ca" target="tn_tao_tab">
          <mxGeometry relative="1" as="geometry">
