        <mxCell id="ht_val_voucher" value="Validate Voucher (Phiếu giảm):&#xa;Kiểm tra ngày hiệu lực, số lượng&#xa;&amp; đơn hàng tối thiểu thỏa mãn" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#0f172a;" vertex="1" parent="lane_he_thong">
          <mxGeometry x="865" y="40" width="170" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ht_api_ghn" value="Kết nối API Giao Hàng Nhanh:&#xa;Lấy mã Province/District/Ward&#xa;&amp; tính cước ship theo kích thước/KL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#9a3412;" vertex="1" parent="lane_he_thong">
          <mxGeometry x="1035" y="150" width="175" height="65" as="geometry" />
        </mxCell>

        <mxCell id="ht_gen_vietqr" value="Dịch vụ VietQR Napas247:&#xa;Sinh QR payload chuẩn EMVCo&#xa;kèm số tiền &amp; nội dung chuyển khoản" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#0369a1;" vertex="1" parent="lane_he_thong">
          <mxGeometry x="1555" y="150" width="170" height="65" as="geometry" />
        </mxCell>

        <!-- TRANSACTION DATABASE NGUYÊN TỬ -->
        <mxCell id="ht_db_transaction" value="SPRING BOOT TRANSACTION (@Transactional):&#xa;1. INSERT INTO hoa_don (trang_thai: 'Đã hoàn thành' / 'Đã xác nhận')&#xa;2. INSERT INTO chi_tiet_hoa_don (danh sách đôi giày, giá bán, số lượng)&#xa;3. UPDATE san_pham_chi_tiet: so_luong_ton = so_luong_ton - N&#xa;4. UPDATE phieu_giam_gia: so_luong_dung = so_luong_dung + 1&#xa;5. INSERT INTO giao_dich_thanh_toan (tien_mat, tien_chuyen_khoan)&#xa;6. INSERT INTO lich_su_hoa_don (Ghi nhận vết hành động của thu ngân)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=2.2;fontSize=11;fontFamily=Helvetica;align=left;fontColor=#0f172a;" vertex="1" parent="lane_he_thong">
          <mxGeometry x="1740" y="40" width="290" height="150" as="geometry" />
        </mxCell>

        <mxCell id="ht_ghi_doanh_thu" value="Cập nhật Doanh thu vào Ca:&#xa;Cộng dồn tong_tien_mat &amp;&#xa;tong_chuyen_khoan vào giao_ca" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#475569;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#0f172a;" vertex="1" parent="lane_he_thong">
          <mxGeometry x="1780" y="235" width="210" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ht_dec_loai_xuat" value="Trạng thái&#xa;đơn hàng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontStyle=1;fontColor=#854d0e;" vertex="1" parent="lane_he_thong">
          <mxGeometry x="2100" y="85" width="90" height="65" as="geometry" />
        </mxCell>

        <mxCell id="ht_tao_vd_ghn" value="Đẩy đơn sang GHN:&#xa;Tạo mã vận đơn, in phiếu giao&#xa;&amp; lưu trạng thái 'Chờ giao hàng'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#9a3412;" vertex="1" parent="lane_he_thong">
