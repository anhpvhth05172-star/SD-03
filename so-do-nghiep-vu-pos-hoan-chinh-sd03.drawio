        <mxCell id="tn_ket_hop" value="Kết hợp (Tiền mặt + QR):&#xa;Chia tỷ lệ số tiền trả mặt&#xa;và số tiền chuyển khoản" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;fontColor=#6d28d9;" vertex="1" parent="lane_thu_ngan">
