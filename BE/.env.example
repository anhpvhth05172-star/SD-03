# GHN shipping configuration (documentation only)
# Spring Boot does NOT read .env automatically. Set these as OS environment
# variables, IDE run-config variables, or JVM -D flags before starting the BE.
# Never commit real values to Git.

# GHN base URL - default is Staging. Production: https://online-gateway.ghn.vn
GHN_API_URL=https://dev-online-gateway.ghn.vn

# API token from GHN account settings (khachhang.ghn.vn / staging 5sao.ghn.dev)
GHN_TOKEN=

# Shop ID from GHN account settings
# Option 1 (official docs): read it in the Developer Portal account page
#   https://developer.ghn.dev -> Log in -> Manage token (/account), ShopId shown in account info
# Option 2 (API): GET {GHN_API_URL}/shiip/public-api/v2/shop/all?offset=0&limit=20
#   header Token: <GHN_TOKEN>  (no ShopId needed)
#   -> data.shops[]._id is the ShopId (docs: developer.ghn.dev/en/docs/shop/get-shop)
GHN_SHOP_ID=

# Optional overrides (defaults shown)
# GHN_SERVICE_TYPE_ID=2
# GHN_PACKAGE_LENGTH_CM=30
# GHN_PACKAGE_WIDTH_CM=20
# GHN_PACKAGE_HEIGHT_CM=15
# GHN_DEFAULT_ITEM_WEIGHT_G=500
# GHN_MAX_WEIGHT_G=30000
# GHN_INSURANCE_MAX_VND=5000000
# GHN_FROM_DISTRICT_ID=
# GHN_FROM_WARD_CODE=
# GHN_TIMEOUT_MS=10000
